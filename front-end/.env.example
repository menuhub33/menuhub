# Laravel back-end (server-side only; Server Actions and route handlers call it).
API_URL=http://localhost:8000/api/v1

# Public URL of this front-end (used for custom-domain resolution and absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root domain for `{slug}.example.com` storefronts. Leave empty in local development.
NEXT_PUBLIC_ROOT_DOMAIN=

# Optional CDN in front of the back-end media disk (adds an <Image> remote pattern).
MEDIA_PUBLIC_URL=
